# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# Database — SQLite by default for local dev (zero setup).
# For production, swap to Postgres (see README "Going to production").
DATABASE_URI=file:./dgb-enterprise.db

# This service's own public URL (used for CORS origin, admin links, media URLs)
PAYLOAD_URL=http://localhost:4000

# The Frontend app's origin — added to CORS/CSRF allow-lists so it can call
# this API from the browser and from its server components.
FRONTEND_URL=http://localhost:3000

# Media storage (S3 / Cloudflare R2) — leave blank to use local disk in dev
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
