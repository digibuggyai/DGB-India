# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Applies across both Frontend/ and Backend/ — patterns are unanchored on purpose.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# payload
# Uploaded files, in the Backend only. Anchored with a leading slash: a bare
# "media/" also matched Frontend/src/app/api/admin/blog/media/, so the blog's
# upload route was silently never committed and 405'd in production.
/Backend/media/
*.db
*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# Database snapshots — password hashes and every enquiry. Never commit these.
backups/
