# The Backend (Payload) API this app reads content from.
NEXT_PUBLIC_API_URL=http://localhost:4000

# This site's own public URL (used for sitemap, JSON-LD, absolute links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload API key for a service account with access to create Leads.
# Generate one in the Backend admin panel (Users -> service account -> API Key)
# after seeding. Sent as an Authorization header from the /api/contact route —
# never exposed to the browser (no NEXT_PUBLIC_ prefix).
BACKEND_SERVICE_API_KEY=

# Spam protection (Cloudflare Turnstile) — leave blank to disable in dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend) — lead notification sent right after a successful submission
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
  